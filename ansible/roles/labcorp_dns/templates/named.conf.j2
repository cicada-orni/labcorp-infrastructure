// Managed by Ansible: labcorp_dns
options {
	directory "/var/named";
	pid-file "/run/named/named.pid";
	listen-on port 53 { 127.0.0.1; {{ labcorp_dns_listen_address }}; };	
	listen-on-v6 port 53 { ::1; };
	allow-query { localhost; 10.50.20.1; };
	allow-transfer { none; };
	recursion no;
	dnssec-validation no;
        include "/etc/crypto-policies/back-ends/bind.config";
};

include "/etc/named.labcorp.zones";

