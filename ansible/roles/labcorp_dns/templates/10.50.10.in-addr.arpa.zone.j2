$TTL 300
$ORIGIN 10.50.10.in-addr.arpa.

@ IN SOA dns01.labcorp.internal. hostmaster.labcorp.internal. (
	2026103001 ; serial
	3600	   ; refresh
	900        ; retry
	604800	   ; expire
	300	   ; minimum (negative caching)
)

@ IN NS dns01.labcorp.internal.
@ IN NS dns02.labcorp.internal.

20 IN PTR monitor01.labcorp.internal.
21 IN PTR logs01.labcorp.internal.
22 IN PTR backup01.labcorp.internal.
