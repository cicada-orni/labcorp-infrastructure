$TTL 300
$ORIGIN 20.50.10.in-addr.arpa.

@ IN SOA dns01.labcorp.internal. hostmaster.labcorp.internal. (
	2026102501 ; serial
	3600	   ; refresh
	900	   ; retry
	604800	   ; expire
	300	   ; minimum (negative caching)
)

@ IN NS dns01.labcorp.internal.
@ IN NS dns02.labcorp.internal.

10 IN PTR dns01.labcorp.internal.
11 IN PTR dns02.labcorp.internal.
20 IN PTR intranet01.labcorp.internal.
21 IN PTR hr-app01.labcorp.internal.
22 IN PTR finance-app01.labcorp.internal.
30 IN PTR db01.labcorp.internal.
40 IN PTR files01.labcorp.internal.
