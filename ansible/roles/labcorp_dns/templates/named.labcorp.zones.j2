zone "labcorp.internal." IN {
	type {{ labcorp_dns_zone_type }};
	file "{{ labcorp_dns_zone_file }}";
{% if labcorp_dns_zone_type == "primary" %}
	allow-query { localhost; 10.50.20.1; 10.50.20.11; };
	allow-transfer { 10.50.20.11; };
	allow-update { none; };
{% endif %}
{% if labcorp_dns_zone_type == "secondary" %}
	primaries { 10.50.20.10; };
{% endif %}
};

zone "20.50.10.in-addr.arpa." IN {
	type {{ labcorp_dns_zone_type }};
	file "{{ labcorp_dns_reverse_zone_file }}";
{% if labcorp_dns_zone_type == "primary" %}
	allow-query { localhost; 10.50.20.1; 10.50.20.11; };
	allow-transfer { 10.50.20.11; };
	allow-update { none; };
{% endif %}
{% if labcorp_dns_zone_type == "secondary" %}
	primaries { 10.50.20.10; };
{% endif %}
};

zone "10.50.10.in-addr.arpa." IN {
	type {{ labcorp_dns_zone_type }};
	file "{{ labcorp_dns_mgmt_reverse_zone_file }}";
{% if labcorp_dns_zone_type == "primary" %}
	allow-query { localhost; 10.50.20.1; 10.50.20.11; };
	allow-transfer { 10.50.20.11; };
	allow-update { none; };
{% endif %}
{% if labcorp_dns_zone_type == "secondary" %}
	primaries { 10.50.20.10; };
{% endif %}
};
